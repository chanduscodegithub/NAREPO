    <description>This process pertains to updating company fields   - Total Ees, Business line and Comments - Reporting field.</description>
    <environments>Default</environments>
    <formulas>
        <name>CopyComment</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Comments__c} , 4095)</expression>
    </formulas>
    <formulas>
        <name>CVGAssoicateUpdateFormula</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.CVGAccount__c})) || ISCHANGED({!$Record.CVGAccount__c})</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>IsNewCompany_7UMRClient</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), ISPICKVAL({!$Record.Company_Tier_Medical__c} , &quot;7-UMR Client&quot;) )</expression>
    </formulas>
    <formulas>
        <name>IsNewCVGUpdate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()
&amp;&amp;
{!$Record.CVGAccount__c} &lt;&gt; NULL</expression>
    </formulas>
    <formulas>
        <name>IsNewNotCompany_7UMRClient</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), NOT(ISPICKVAL({!$Record.Company_Tier_Medical__c} , &quot;7-UMR Client&quot;) ))</expression>
    </formulas>
    <formulas>
        <name>NotBlankComment</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp; NOT(ISBLANK({!$Record.Comments__c} ) )</expression>
    </formulas>
    <formulas>
        <name>SubTypeFormula</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.RecordType.Name} , &quot;Pending Transfer In Client&quot;, &quot;Pending Transfer In Client&quot;,&quot;Sold Client&quot;, &quot;Sold Client&quot;, &quot;Prospect&quot;, &quot;Prospect&quot;, &quot;Prospect Subsidiary&quot;, &quot;Prospect Subsidiary&quot;, &quot;Suspect&quot;, &quot;Suspect&quot;, &quot;Consulting Firm&quot;, &quot;Consulting Firm&quot;, &quot;Competitor&quot;, &quot;Competitor&quot;, TEXT({!$Record.Subtype__c} )   )</expression>
    </formulas>
    <formulas>
        <name>VerifiedByFullName</name>
        <dataType>String</dataType>
        <expression>{!$Record.LastModifiedBy.FirstName} &amp; &quot; &quot; &amp; {!$Record.LastModifiedBy.LastName}</expression>
    </formulas>
