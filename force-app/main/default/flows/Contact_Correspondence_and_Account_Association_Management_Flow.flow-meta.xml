    <description>This flow automates the management of correspondence settings and account-contact relations for Contact and Consultant records. It updates correspondence preferences based on status changes, manages picklist fields, and handles the deletion of inactive account-contact relations. It ensures consistent handling of correspondence preferences and account relationships for active and inactive consultants, including sending notifications and clearing appropriate fields.



Correspondence Association When Edited V8.0   ---   When Do Not Checked/ Correspond Type Updated.
AccountContactRelationDelete  ---  This process is used to Send Contact &quot;Inactive to Active&quot; Email and Delete AccountContactJunction records</description>
    <environments>Default</environments>
    <formulas>
        <name>CorrespondTypeFormula</name>
        <dataType>String</dataType>
        <expression>IF(AND(INCLUDES({!$Record.Correspondence_Type__c} , &quot;Customer Survey - Primary&quot;),INCLUDES({!$Record.Correspondence_Type__c} , &quot;Customer Survey - Secondary&quot;)),&quot;Customer Survey - Primary;Customer Survey - Secondary&quot;,IF(INCLUDES({!$Record.Correspondence_Type__c} , &quot;Customer Survey - Primary&quot;),&quot;Customer Survey - Primary&quot;,IF(INCLUDES({!$Record.Correspondence_Type__c} , &quot;Customer Survey - Secondary&quot;),&quot;Customer Survey - Secondary&quot;,&quot;&quot;)))</expression>
    </formulas>
    <formulas>
        <name>DateToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>IsNewDateToday</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()  &amp;&amp; ISPICKVAL({!$Record.Status__c} , &quot;Inactive&quot;)</expression>
    </formulas>
    <formulas>
        <name>PriorRecordValue</name>
        <dataType>String</dataType>
        <expression>PRIORVALUE({!$Record.Status__c})</expression>
    </formulas>
