        <name>ListViewSearchFomula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Staff_User_Assignment__r.LastName} + &apos; &apos; + {!$Record.Staff_User_Assignment__r.FirstName}</expression>
    </formulas>
    <formulas>
        <name>NewStaffAssFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>NewStaffAssmercerFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp; TEXT( {!$Record.Customer_Name__r.Private_Exchange_Client__c}) = &apos;Mercer Marketplace&apos;</expression>
    </formulas>
    <formulas>
        <name>NewStaffAssnonmercerFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp; TEXT( {!$Record.Customer_Name__r.Private_Exchange_Client__c}) != &apos;Mercer Marketplace&apos;</expression>
    </formulas>
    <formulas>
        <name>RoleCMCformula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Role_on_Case__c} , &apos;Client Management Consultant&apos;)  &amp;&amp;(ISCHANGED({!$Record.Role_on_Case__c}) ||  ISNEW() )</expression>
    </formulas>
    <formulas>
        <name>RoleSBCformula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Role_on_Case__c} , &apos;Specialty Benefits Client Manager&apos;)  &amp;&amp;(ISCHANGED({!$Record.Role_on_Case__c}) ||  ISNEW() )</expression>
    </formulas>
    <formulas>
        <name>RoleUMRCMFormula</name>
        <dataType>Boolean</dataType>
        <expression>(ISPICKVAL({!$Record.Role_on_Case__c} , &apos;UMR Client Manager&apos;) || ISPICKVAL({!$Record.Role_on_Case__c} , &apos;Surest Client Manager&apos;)) &amp;&amp;(ISCHANGED({!$Record.Role_on_Case__c}) ||  ISNEW() )</expression>
    </formulas>
    <formulas>
        <name>UpdatedAMTFormula</name>
        <dataType>Boolean</dataType>
        <expression>OR(
	AND(ISCHANGED({!$Record.Staff_User_Assignment__r.Id} ),  {!$Record.Should_Extended_AMT_be_updated__c} = TRUE,{!$Record.Staff_User_Assignment__r.Id!=} null),
	AND(ISCHANGED({!$Record.Should_Extended_AMT_be_updated__c} ),  {!$Record.Should_Extended_AMT_be_updated__c} = TRUE,{!$Record.Staff_User_Assignment__r.Id!=} null),
	AND(ISNEW(),{!$Record.Staff_User_Assignment__r.Id}  != null,{!$Record.Should_Extended_AMT_be_updated__c} = True) 
)</expression>
    </formulas>
