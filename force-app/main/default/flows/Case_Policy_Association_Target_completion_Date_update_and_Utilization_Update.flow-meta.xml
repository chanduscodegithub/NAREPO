    <description>This process associates the company polices to the case, calculate the Traget completion date and update the Utilization score and description on service user utilization records.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>IsNewAccount</name>
        <dataType>Boolean</dataType>
        <expression>AND (ISNEW(),  !ISNULL({!$Record.AccountId}))</expression>
    </formulas>
    <formulas>
        <name>IsNewNotEmail</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp; NOT( ISPICKVAL({!$Record.Origin} , &apos;Email&apos;))</expression>
    </formulas>
    <formulas>
        <name>IsNewWithEmail</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp;  ISPICKVAL({!$Record.Origin} , &apos;Email&apos;)</expression>
    </formulas>
    <formulas>
        <name>UserId</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
