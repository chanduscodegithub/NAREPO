    <decisions>
        <name>Completed_Or_Cancelled_Notification</name>
        <label>Completed Or Cancelled Notification</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Completed_Notification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Alert_to_Record_Creator</targetReference>
            </connector>
            <label>Completed Notification</label>
        </rules>
        <rules>
            <name>Cancelled_Notification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Cancellation_Email</targetReference>
            </connector>
            <label>Cancelled Notification</label>
        </rules>
    </decisions>
