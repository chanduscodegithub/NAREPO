                <targetReference>Assign_to_SBS_Mailbox</targetReference>
            </connector>
            <label>IsNew True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Long_Term_Issue</name>
        <label>Long Term Issue</label>
        <locationX>182</locationX>
        <locationY>803</locationY>
        <defaultConnector>
            <targetReference>Updating_Issue_Description</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Long_Term_Issue_IsTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quality</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_field_LongTermIssue</targetReference>
            </connector>
            <label>Long Term Issue IsTrue</label>
        </rules>
    </decisions>
    <decisions>
        <name>PHI_Case_Checked</name>
        <label>PHI Case Checked</label>
        <locationX>765</locationX>
        <locationY>1403</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PHI_Case_Checked_IsTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PHI_Case__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PHI_Case__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Issue_Description_as_Blank</targetReference>
            </connector>
            <label>PHI Case Checked IsTrue</label>
        </rules>
    </decisions>
    <decisions>
        <name>PHI_Case_not_Checked</name>
        <label>PHI Case not Checked</label>
        <locationX>567</locationX>
        <locationY>1295</locationY>
        <defaultConnector>
            <targetReference>PHI_Case_Checked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>PHI Case not Checked IsFalse</defaultConnectorLabel>
        <rules>
            <name>PHI_Case_not_Checked_IsTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PHIcaseNotCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Issue_Description_not_Blank</targetReference>
            </connector>
            <label>PHI Case not Checked IsTrue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Updating_Issue_Description</name>
        <label>Updating Issue Description</label>
        <locationX>336</locationX>
        <locationY>1187</locationY>
        <defaultConnector>
            <targetReference>PHI_Case_not_Checked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Updating Issue Description IsFalse</defaultConnectorLabel>
        <rules>
            <name>Updating_Issue_Description_IsTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewPHIcaseFalse</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_Issue_Description_with_Description_value</targetReference>
            </connector>
            <label>Updating Issue Description IsTrue</label>
        </rules>
    </decisions>
    <description>This process automates the assignment of SBS support cases, categorizes quality cases as long-term issues, and populates the ‘Issue Description’ field on a case.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>NewPHIcaseFalse</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), {!$Record.PHI_Case__c} = FALSE, LEN({!$Record.Description}) &gt; 0)</expression>
    </formulas>
    <formulas>
        <name>PHIcaseNotCheck</name>
        <dataType>Boolean</dataType>
        <expression>(({!$Record.PHI_Case__c} = FALSE) &amp;&amp; (ISCHANGED({!$Record.PHI_Case__c}))) &amp;&amp; (ISCHANGED({!$Record.Description}) || LEN({!$Record.Description}) &gt; 0)</expression>
    </formulas>
    <interviewLabel>Case Field Updates - Automation Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Field Updates - Automation Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
