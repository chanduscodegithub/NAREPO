    <formulas>
        <name>IsnewCompletedDateTrue</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()  &amp;&amp; NOT( ISBLANK({!$Record.Completed_Date__c}  ))</expression>
    </formulas>
    <formulas>
        <name>IsNewFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp;  
( 
    ISPICKVAL({!$Record.Status}, &apos;Completed&apos;) || 
    ISPICKVAL({!$Record.Status}, &apos;Closed&apos;) || 
    ISPICKVAL({!$Record.Status}, &apos;Retro Completed&apos;) || 
    ISPICKVAL({!$Record.Status}, &apos;Enhancement Completed&apos;) 
)</expression>
    </formulas>
    <formulas>
        <name>IssueTaskNotificationFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.RecordTypeId} != NULL,
	AND(
		{!$Record.RecordType.DeveloperName} = &apos;Quality&apos; ,
		OR(
			AND(ISNEW(),{!$Record.Owner:User.Id} != NULL),
			ISCHANGED({!$Record.Owner:User.Id})
		)
	)	
)</expression>
    </formulas>
    <formulas>
        <name>OtherRTTaskNotification</name>
        <dataType>Boolean</dataType>
        <expression>OR(AND(ISNEW(),{!$Record.Owner:User.Id} != NULL), ISCHANGED({!$Record.Owner:User.Id}))</expression>
    </formulas>
    <formulas>
        <name>RemainderSetField</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(),{!$Record.RecordTypeId} != NULL,{!$Record.RecordType.DeveloperName}  = &apos;Quality&apos;)</expression>
    </formulas>
