    <description>Excluding ETS-BE Record Type</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( ISNEW(), [Case].PHI_Case__c= FALSE, LEN ([Case].Description) &gt; 0, [Case].RecordType.DeveloperName &lt;&gt; &apos;ETS_BE_Request&apos;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), {!myVariable_current.PHI_Case__c}= FALSE, LEN ({!myVariable_current.Description}) &gt; 0, {!myVariable_current.RecordType.DeveloperName} &lt;&gt; &apos;ETS_BE_Request&apos;)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>(([Case].PHI_Case__c = FALSE)&amp;&amp;(ISCHANGED([Case].PHI_Case__c))) &amp;&amp; (ISCHANGED([Case].Description) || LEN([Case].Description) &gt; 0) &amp;&amp; [Case].RecordType.DeveloperName &lt;&gt; &apos;ETS_BE_Request&apos;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>(({!myVariable_current.PHI_Case__c} = FALSE)&amp;&amp;(ISCHANGED({!myVariable_current.PHI_Case__c}))) &amp;&amp; (ISCHANGED({!myVariable_current.Description}) || LEN({!myVariable_current.Description}) &gt; 0) &amp;&amp; {!myVariable_current.RecordType.DeveloperName} &lt;&gt; &apos;ETS_BE_Request&apos;</expression>
