    <description>This process sends email alerts and update the case fields such as completed Date, Cancel Customer, CSI Private Company and Public Company.</description>
    <environments>Default</environments>
    <formulas>
        <name>AMTmemberSetEmail</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.RecordType.DeveloperName}  = &apos;BCI_Review&apos;,
	OR(
                AND(ISNEW(),ISBLANK({!$Record.AMT_Member__c} ) = FALSE),
		AND(ISBLANK({!$Record.AMT_Member__c} ) = FALSE,
                          ISCHANGED({!$Record.AMT_Member__c} ) = TRUE
                ),
				ISCHANGED({!$Record.RecordType.Id}) =TRUE
	)
)</expression>
    </formulas>
    <formulas>
        <name>BCIclosedFormula</name>
        <dataType>Boolean</dataType>
        <expression>OR(
      AND(ISNEW(),
                {!$Record.RecordType.DeveloperName} = &apos;BCI_Review&apos;,
                NOT(ISBLANK(TEXT({!$Record.Status}))),
                OR(ISPICKVAL({!$Record.Status},&apos;Closed&apos;),
                       ISPICKVAL({!$Record.Status},&apos;On Hold&apos;),
                       ISPICKVAL({!$Record.Status},&apos;Work In Progress&apos;),
                       ISPICKVAL({!$Record.Status},&apos;CM Action Required&apos;)
                )
      ),
      AND({!$Record.RecordType.DeveloperName} = &apos;BCI_Review&apos;,
                ISCHANGED({!$Record.Status}), 
                NOT(ISBLANK(TEXT({!$Record.Status}))),
                OR(ISPICKVAL({!$Record.Status},&apos;Closed&apos;),
                       ISPICKVAL({!$Record.Status},&apos;On Hold&apos;),
                       ISPICKVAL({!$Record.Status},&apos;Work In Progress&apos;),
                       ISPICKVAL({!$Record.Status},&apos;CM Action Required&apos;)
                )
      ) 
)</expression>
    </formulas>
    <formulas>
        <name>DataValueClosedDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.ClosedDate})</expression>
    </formulas>
    <formulas>
        <name>IsNewClosed</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp; ISPICKVAL({!$Record.Status} , &apos;Closed&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsNewFirst</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>IsnewNotDatecomplete</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()  &amp;&amp; NOT( ISBLANK({!$Record.Date_Completed__c} ))</expression>
    </formulas>
