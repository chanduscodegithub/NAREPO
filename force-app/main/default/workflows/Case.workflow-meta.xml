        <notifyAssignee>false</notifyAssignee>
        <operation>LookupValue</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Long_Term_Issue</fullName>
        <field>Long_Term_Issue__c</field>
        <literalValue>1</literalValue>
        <name>Update Long Term Issue</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Rich_Text_Description</fullName>
        <field>Extended_Description__c</field>
        <formula>Description</formula>
        <name>Update Rich Text Description</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Assign to SBS Mailbox</fullName>
        <actions>
            <name>Set_the_Issue_Owner_to_SBS</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>User.ProfileId</field>
            <operation>notEqual</operation>
            <value>CSI Administrator</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>SBS Support</value>
        </criteriaItems>
        <description>Assign to SBS Mailbox queue for issues created by non-admin users</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>IS Queue Notification</fullName>
        <actions>
            <name>IS_Queue_Notification_Alert</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Case.OwnerId</field>
            <operation>equals</operation>
            <value>IS Queue</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Long Term Issue</fullName>
        <actions>
            <name>Update_Long_Term_Issue</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>Quality</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>SBS Mailbox Issue Notification</fullName>
        <actions>
            <name>Email_Notification_to_SBS_Mailbox_Queue_Members</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>SBS Support</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Queue_User_Check__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Category__c</field>
            <operation>notEqual</operation>
            <value>ERM</value>
        </criteriaItems>
        <description>Whenever a new SBS Support Issue is created in the system, this workflow will trigger and send a notification to SBS Queue Members</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Training Team Notification</fullName>
        <actions>
            <name>Training_Team_Knowledge_Alerts</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Case.OwnerId</field>
            <operation>contains</operation>
            <value>Training</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
