    <fieldUpdates>
        <fullName>Set_the_Issue_Owner_to_IS_Queue</fullName>
        <field>OwnerId</field>
        <lookupValue>IS_Queue</lookupValue>
        <lookupValueType>Queue</lookupValueType>
        <name>Set the Issue Owner to IS Queue</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>LookupValue</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_the_Issue_Owner_to_SBS</fullName>
        <field>OwnerId</field>
        <lookupValue>Service_Mailbox_Queue</lookupValue>
        <lookupValueType>Queue</lookupValueType>
