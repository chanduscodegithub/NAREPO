<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>QA_Form_Email_Alert</fullName>
        <description>QA Form Email Alert</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/QA_Form_Email_Template</template>
    </alerts>
    <alerts>
        <fullName>QA_Form_Other_RT_Email_Alert</fullName>
        <description>QA Form Other RT Email Alert</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/QA_Form_Other_RT_Email_Template</template>
    </alerts>
    <alerts>
        <fullName>Task_Completion_Alert</fullName>
        <description>Task Completion Alert</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>UHG_Case_Templates/Task_Completed</template>
    </alerts>
    <rules>
        <fullName>Task Completed</fullName>
        <actions>
            <name>Task_Completion_Alert</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <description>If task is created by user and assigned to user are different, then task closed email will be sent.</description>
        <formula>(OwnerId &lt;&gt; CreatedById) &amp;&amp; (OR(ISPICKVAL(Status,&quot;Completed&quot;),ISPICKVAL(Status,&quot;Closed&quot;)))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
