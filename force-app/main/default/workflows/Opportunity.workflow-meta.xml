<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>CMOpportunityModificationNotification</fullName>
        <description>If MA Business Type = CM and any one apart from the Admin tries modifies the record</description>
