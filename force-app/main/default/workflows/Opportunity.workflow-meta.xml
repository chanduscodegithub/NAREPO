    <alerts>
        <fullName>Send_email_when_Proactive_Renewal_Override_changes</fullName>
        <ccEmails>samarth.nadig@crmit.com</ccEmails>
        <ccEmails>anil.nagaraja@crmit.com</ccEmails>
        <description>Send email when &quot;Proactive Renewal -Override&quot; changes</description>
        <protected>false</protected>
        <senderType>CurrentUser</senderType>
        <template>UHGEmailTemplates/ProActive</template>
    </alerts>
    <fieldUpdates>
        <fullName>Set_Classisfication_field_default_value</fullName>
        <field>Classification_NB_NBEA_Xfer__c</field>
        <literalValue>Xfer from KA</literalValue>
        <name>Set Classisfication field default value</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>MA %22Classification %28NB%2CNBEA%2CXfer%29%22 default value</fullName>
        <actions>
            <name>Set_Classisfication_field_default_value</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND(RecordType.Name=&quot;CM Membership Activity (Existing Client)&quot;, ISPICKVAL(Reason_for_the_Opportunity_Risk__c,&quot;Intersegment Transfer&quot;))</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Proactive Renewal Status Change Mail</fullName>
        <actions>
            <name>Send_email_when_Proactive_Renewal_Override_changes</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <description>Send a mail whenever &quot;Proactive Renewal - override&quot; value changes</description>
        <formula>ISCHANGED(  Proactive_Renewal_Override__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
