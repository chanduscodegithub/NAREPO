            <recipient>automatedprocess@uhg.na</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>UHGEmailTemplates/CM_Opportunity_Modification_Notification</template>
    </alerts>
