<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Funding_Type__c</fullName>
    <description>Populating the values from Company Fields based on Competitor classification Field From Competitor Object</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Competitorclassification__c, &apos;Dental&apos;),  TEXT(Account__r.DentalFundingType__c), 
  IF(ISPICKVAL(Competitorclassification__c, &apos;Vision&apos;), TEXT(Account__r.VisionFundingType__c),
  null))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Funding Type</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
