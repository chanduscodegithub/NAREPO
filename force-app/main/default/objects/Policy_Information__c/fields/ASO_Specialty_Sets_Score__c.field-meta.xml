<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ASO_Specialty_Sets_Score__c</fullName>
    <externalId>false</externalId>
    <formula>IF( AND(ASO_Specialty_Sets__c &gt;= 1, ASO_Specialty_Sets__c &lt;= 10), ASO_Specialty_Sets__c *  $CustomMetadata.Capacity_Planning_SBC_Calculation_Weight__mdt.Weightages.ASO_Specialty_Sets_Weightage__c * 12,
				
	IF(ASO_Specialty_Sets__c &gt; 10, ((ASO_Specialty_Sets__c - 10)*0.25+100)*12, 0))</formula>
